      "statement": "<p>Solve for <em>x</em>: x^2 - 5x + 6 = 0</p>",
      "statementFigure": null,
      "steps": [
        {
          "role": "step",
          "content": "<p>Factor: (x - 2)(x - 3) = 0</p>"
        },
        {
          "role": "step",
          "content": "<p>So x = 2 or x = 3</p>"
        }
      ]
