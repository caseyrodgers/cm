      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eView the table.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_18674\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2nd.gif\"\u003e \u003cimg id\u003d\"token_18675\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qtable.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18675\u0026quot;,228)\"\u003e to view the table.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-7 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_6_1_proportionsandratios_10a_50/f-50-10a-3.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eScroll down until the Y\u003csub\u003e1\u003c/sub\u003e column is greater than 100.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eScroll down until the Y\u003csub\u003e1\u003c/sub\u003e column is greater than 100.\u003c/p\u003e\n \u003cp\u003eThis occurs when \u003ci\u003ex\u003c/i\u003e \u003d 15.\u003c/p\u003e\n \u003cp\u003eSo, the bear population doubles after 15 years.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-9 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_6_1_proportionsandratios_10a_50/f-50-10a-4.gif\"\u003e\n\u003cbr\u003e",
