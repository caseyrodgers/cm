    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eMake sure the \u003cimg id\u003d\"token_18670\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qtblset.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18670\u0026quot;,231)\"\u003e values are set to TblStart \u003d 0, Δ Tbl \u003d 1.\u003c/p\u003e\n\u003c/div\u003e",
