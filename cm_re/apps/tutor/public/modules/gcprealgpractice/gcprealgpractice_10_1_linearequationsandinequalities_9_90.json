    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eTo enter the right hand side of the inequality, press \u003cimg id\u003d\"token_21473\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21473\u0026quot;,211)\"\u003e \u003cimg id\u003d\"token_21474\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21474\u0026quot;,211)\"\u003e \u003cimg id\u003d\"token_21475\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2.gif\"\u003e \u003cimg id\u003d\"token_21476\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2.gif\"\u003e \u003cimg id\u003d\"token_21477\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q0.gif\"\u003e\u003cimg id\u003d\"token_21478\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qx73.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21478\u0026quot;,263)\"\u003e \u003cimg id\u003d\"token_21479\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qplus.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21479\u0026quot;,203)\"\u003e \u003cimg id\u003d\"token_21480\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q3.gif\"\u003e \u003cimg id\u003d\"token_21481\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q5.gif\"\u003e \u003cimg id\u003d\"token_21482\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q0.gif\"\u003e.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-3 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_10_1_linearequationsandinequalities_9_90/f-90-10-2.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
