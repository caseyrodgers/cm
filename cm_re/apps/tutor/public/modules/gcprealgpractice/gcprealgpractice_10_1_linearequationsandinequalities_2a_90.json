  "widgetSlot": null,
  "steps": [
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_20592\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qlist.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20592\u0026quot;,175)\"\u003e and enter the \u003ci\u003ex\u003c/i\u003e–coordinates of the points.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_20593\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qlist.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20593\u0026quot;,175)\"\u003e. Enter the \u003ci\u003ex\u003c/i\u003e–coordinates of the points in L\u003csub\u003e1\u003c/sub\u003e by pressing \u003cimg id\u003d\"token_20594\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q0.gif\"\u003e \u003cimg id\u003d\"token_20595\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdot.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20595\u0026quot;,135)\"\u003e \u003cimg id\u003d\"token_20596\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2.gif\"\u003e \u003cimg id\u003d\"token_20597\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20597\u0026quot;,144)\"\u003e, \u003cimg id\u003d\"token_20598\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q0.gif\"\u003e \u003cimg id\u003d\"token_20599\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdot.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20599\u0026quot;,135)\"\u003e \u003cimg id\u003d\"token_20600\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q3.gif\"\u003e \u003cimg id\u003d\"token_20601\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20601\u0026quot;,144)\"\u003e, \u003cimg id\u003d\"token_20602\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q0.gif\"\u003e \u003cimg id\u003d\"token_20603\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdot.gif\" onmouseout\u0