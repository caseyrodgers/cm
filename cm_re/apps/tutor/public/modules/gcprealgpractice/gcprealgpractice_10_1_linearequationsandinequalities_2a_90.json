      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_20606\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20606\u0026quot;,211)\"\u003e and enter the \u003ci\u003ey\u003c/i\u003e–coordinates of the points.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_20607\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20607\u0026quot;,211)\"\u003e. Enter the \u003ci\u003ey\u003c/i\u003e–coordinates of the points in L\u003csub\u003e2\u003c/sub\u003e by pressing \u003cimg id\u003d\"token_20608\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2.gif\"\u003e \u003cimg id\u003d\"token_20609\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdot.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20609\u0026quot;,135)\"\u003e \u003cimg id\u003d\"token_20610\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2.gif\"\u003e \u003cimg id\u003d\"token_20611\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q5.gif\"\u003e \u003cimg id\u003d\"token_20612\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20612\u0026quot;,144)\"\u003e, \u003cimg id\u003d\"token_20613\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2.gif\"\u003e \u003cimg id\u003d\"token_20614\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdot.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20614\u0026quot;,135)\"\u003e \u003cimg id\u003d\"token_20615\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q1.gif\"\u003e \u003cimg id\u003d\"token_20616\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20616\u0026quot;,144)\"\u003e, \u003cimg id\u003d\"token_20617\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2.gif\"\u003e \u003cimg id\u003d\"token_20618\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20618\u0026quot;,144)\"\u003e, etc.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-3 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_10_1_linearequationsandinequalities_2a_90/f-90-2-2.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eTurn the \u003ci\u003ePlot\u003c/i\u003e on.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_20619\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2nd.gif\"\u003e \u003cimg id\u003d\"token_20621\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20621\u0026quot;,144)\"\u003e \u003cimg id\u003d\"token_20622\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20622\u0026quot;,144)\"\u003e to turn \u003ci\u003ePlot 1\u003c/i\u003e on. Make sure \u003ci\u003eType\u003c/i\u003e is set to scatter–plot, Xlist to L\u003csub\u003e1\u003c/sub\u003e and Ylist to L\u003csub\u003e2\u003c/sub\u003e.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-5 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_10_1_linearequationsandinequalities_2a_90/f-90-2-3.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cdiv class\u003d\"question\"\u003e\n  \u003cp\u003eWhat would be an appropriate viewing window for this relation?\u003c/p\u003e\n \u003c/div\u003e\n \u003cdiv class\u003d\"question_guess\"\u003e\n  \u003cimg onmouseover\u003d\"doQuestionResponse(\u0027rid_4601\u0027,\u0027no\u0027);\" onmouseout\u003d\"doQuestionResponseEnd();\" src\u003d\"/images/tutor5/hint_question-16x16.gif\" name\u003d\"question_0\"\u003e\u0026nbsp;\n  \u003cp\u003eXmin \u003d –10, Xmax \u003d 10, Xscl \u003d 1, Ymin \u003d –10, Ymax \u003d 10, Yscl \u003d 1\u003c/p\u003e\n \u003c/div\u003e\n \u003cdiv class\u003d\"question_guess\"\u003e\n  \u003cimg onmouseover\u003d\"doQuestionResponse(\u0027rid_4602\u0027,\u0027no\u0027);\" onmouseout\u003d\"doQuestionResponseEnd();\" src\u003d\"/images/tutor5/hint_question-16x16.gif\" name\u003d\"question_1\"\u003e\u0026nbsp;\n  \u003cp\u003eXmin \u003d –1.5, Xmax \u003d 1.5, Xscl \u003d 0.2, Ymin \u003d –3, Ymax \u003d 3, Yscl \u003d 0.3\u003c/p\u003e\n \u003c/div\u003e\n \u003cdiv class\u003d\"question_guess\"\u003e\n  \u003cimg onmouseover\u003d\"doQuestionResponse(\u0027rid_4603\u0027,\u0027yes\u0027);\" onmouseout\u003d\"doQuestionResponseEnd();\" src\u003d\"/images/tutor5/hint_question-16x16.gif\" name\u003d\"question_2\"\u003e\u0026nbsp;\n  \u003cp\u003eXmin \u003d 0, Xmax \u003d 1.5, Xscl \u003d 0.1, Ymin \u003d 0, Ymax \u003d 3, Yscl \u003d 0.2\u003c/p\u003e\n \u003c/div\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eThe \u003ci\u003ex\u003c/i\u003e–coordinates range from 0.2 to 1.1, and the \u003ci\u003ey\u003c/i\u003e–coordinates range from 0.90 to 2.25.\u003c/p\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_20623\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qwindow.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20623\u0026quot;,255)\"\u003e and set the dimensions to Xmin \u003d 0, Xmax \u003d 1.5, Xscl \u003d 0.1, Ymin \u003d 0, Ymax \u003d 3, Yscl \u003d 0.2.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-7 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_10_1_linearequationsandinequalities_2a_90/f-90-2-4.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_20624\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qgraph.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20624\u0026quot;,157)\"\u003e.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_20625\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qgraph.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20625\u0026quot;,157)\"\u003e to view the graph.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-9 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_10_1_linearequationsandinequalities_2a_90/f-90-2-5.gif\"\u003e\n\u003cbr\u003e",
