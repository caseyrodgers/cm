    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_18242\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18242\u0026quot;,144)\"\u003e 4 times.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_18243\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18243\u0026quot;,144)\"\u003e 4 times to select the default initial guess and boundaries.\u003c/p\u003e\n \u003cp\u003eThe calculator gives \u003ci\u003ex\u003c/i\u003e \u003d 14.375, verifying our answer.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-9 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_6_1_proportionsandratios_1_50/f-50-1-3.gif\"\u003e\n\u003cbr\u003e",
