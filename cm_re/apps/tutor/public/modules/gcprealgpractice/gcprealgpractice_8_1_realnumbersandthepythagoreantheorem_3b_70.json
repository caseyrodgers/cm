      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_19506\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_19506\u0026quot;,211)\"\u003e \u003cimg id\u003d\"token_19507\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qup.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_19507\u0026quot;,246)\"\u003e so that L\u003csub\u003e2\u003c/sub\u003e is highlighted. Now enter the formula 17\u003csup\u003e2\u003c/sup\u003e – (L\u003csub\u003e1\u003c/sub\u003e)\u003csup\u003e2\u003c/sup\u003e for L\u003csub\u003e2\u003c/sub\u003e. Key in \u003cimg id\u003d\"token_19508\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q1.gif\"\u003e \u003cimg id\u003d\"token_19509\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q7.gif\"\u003e \u003cimg id\u003d\"token_19510\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qxsqr.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_19510\u0026quot;,260)\"\u003e \u003cimg id\u003d\"token_19511\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qminus.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_19511\u0026quot;,185)\"\u003e \u003cimg id\u003d\"token_19512\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2nd.gif\"\u003e \u003cimg id\u003d\"token_19513\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qstat.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_19513\u0026quot;,221)\"\u003e \u003cimg id\u003d\"token_19514\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q1.gif\"\u003e \u003cimg id\u003d\"token_19515\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qxsqr.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_19515\u0026quot;,260)\"\u003e.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-3 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_8_1_realnumbersandthepythagoreantheorem_3b_70/f-70-3b-2.gif\"\u003e\n\u003cbr\u003e",
