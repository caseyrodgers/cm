      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eTo enter the equation, you first have to get 0 on one side. Add 42.9 from both sides.\u003c/p\u003e\n \u003cp\u003eKey in \u003cimg id\u003d\"token_17618\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q5.gif\"\u003e \u003cimg id\u003d\"token_17619\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdot.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_17619\u0026quot;,135)\"\u003e \u003cimg id\u003d\"token_17620\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q5.gif\"\u003e\u003cimg id\u003d\"token_17621\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qx73.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_17621\u0026quot;,263)\"\u003e \u003cimg id\u003d\"token_17622\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qadd.gif\"\u003e \u003cimg id\u003d\"token_17623\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q4.gif\"\u003e \u003cimg id\u003d\"token_17624\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2.gif\"\u003e \u003cimg id\u003d\"token_17625\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdot.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_17625\u0026quot;,135)\"\u003e \u003cimg id\u003d\"token_17626\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q9.gif\"\u003e.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-3 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_4_1_solvingequations_2a_30/f-30-2a-1.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
