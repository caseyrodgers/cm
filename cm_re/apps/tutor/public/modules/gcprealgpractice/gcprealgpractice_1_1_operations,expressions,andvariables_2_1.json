      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eYou can either use the \u003cimg id\u003d\"token_16054\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qfrac.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16054\u0026quot;,154)\"\u003e key to write the fraction bar, or use parentheses. We\u0027ll use the \u003cimg id\u003d\"token_16055\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qfrac.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16055\u0026quot;,154)\"\u003e key.\u003c/p\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_16056\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qfrac.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16056\u0026quot;,154)\"\u003e. In the numerator, key in \u003cimg id\u003d\"token_16057\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q4.gif\"\u003e \u003cimg id\u003d\"token_16058\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qplus.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16058\u0026quot;,203)\"\u003e \u003cimg id\u003d\"token_16059\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q1.gif\"\u003e \u003cimg id\u003d\"token_16060\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q7.gif\"\u003e. Then press \u003cimg id\u003d\"token_16061\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdown.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16061\u0026quot;,136)\"\u003e, and in the denominator, press \u003cimg id\u003d\"token_16062\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q7.gif\"\u003e. Then press \u003cimg id\u003d\"token_16063\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16063\u0026quot;,211)\"\u003e, and key in \u003cimg id\u003d\"token_16064\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qtimes.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16064\u0026quot;,238)\"\u003e \u003cimg id\u003d\"token_16065\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q5.gif\"\u003e.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-1 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_1_1_operations,expressions,andvariables_2_1/f-1-2-1.gif\"\u003e\n\u003cbr\u003e",
