  "statement": "\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eUsing the GEOBOARD application on your calculator, draw the parallelogram with vertices at (0, 0), (4, 0), (6, 5), and (2, 5).\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e",
  "statementFigure": null,
  "question": null,
  "widgetSlot": null,
  "steps": [
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_18936\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qapps.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18936\u0026quot;,108)\"\u003e \u003cimg id\u003d\"token_18937\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q4.gif\"\u003e to enter the application.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_18938\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qapps.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18938\u0026quot;,108)\"\u003e and select \u003cimg id\u003d\"token_18939\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q4.gif\"\u003e to start the GEOBOARD application. Press any key to start.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-1 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_7_1_geometry_2a_60/f-60-2a-1.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eSelect a 8 \u003cimg id\u003d\"token_18940\" class\u003d\"text-bottom\" src\u003d\"/specialchars/times.gif\"\u003e 8 square board.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_18941\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q3.gif\"\u003e to select a 8 \u003cimg id\u003d\"token_18942\" class\u003d\"text-bottom\" src\u003d\"/specialchars/times.gif\"\u003e 8 square board.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-3 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_7_1_geometry_2a_60/f-60-2a-2.gif \"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eTurn the axes on.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_18943\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qzoom.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18943\u0026quot;,267)\"\u003e (\"FMAT\"), and press \u003cimg id\u003d\"token_18944\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdown.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18944\u0026quot;,136)\"\u003e \u003cimg id\u003d\"token_18945\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18945\u0026quot;,211)\"\u003e \u003cimg id\u003d\"token_18946\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18946\u0026quot;,144)\"\u003e to turn the axes on. Then press \u003cimg id\u003d\"token_18947\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qgraph.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18947\u0026quot;,157)\"\u003e (\"QUIT\").\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-5 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_7_1_geometry_2a_60/f-60-2a-3.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_18948\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qyeq.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18948\u0026quot;,265)\"\u003e twice (\"DRAW\", then \"ADD\").\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_18949\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qyeq.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18949\u0026quot;,265)\"\u003e twice (\"DRAW\", then \"ADD\"). Press \u003cimg id\u003d\"token_18950\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18950\u0026quot;,144)\"\u003e to select the origin point (0, 0).\u003c/p\u003e\n \u003cp\u003eThen press \u003cimg id\u003d\"token_18951\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18951\u0026quot;,211)\"\u003e \u003cimg id\u003d\"token_18952\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18952\u0026quot;,211)\"\u003e \u003cimg id\u003d\"token_18953\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18953\u0026quot;,211)\"\u003e \u003cimg id\u003d\"token_18954\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18954\u0026quot;,211)\"\u003e and press \u003cimg id\u003d\"token_18955\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qyeq.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18955\u0026quot;,265)\"\u003e (\"ADD\") again to draw the segment connecting (0, 0) and (4, 0).\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-7 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_7_1_geometry_2a_60/f-60-2a-4.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eComplete the parallelogram.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_18956\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18956\u0026quot;,211)\"\u003e twice and \u003cimg id\u003d\"token_18957\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qup.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18957\u0026quot;,246)\"\u003e five times, followed by \u003cimg id\u003d\"token_18958\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qyeq.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18958\u0026quot;,265)\"\u003e (\"ADD\"), to draw the segment connecting (4, 0) and (6, 5).\u003c/p\u003e\n \u003cp\u003eThen press \u003cimg id\u003d\"token_18959\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qleft.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18959\u0026quot;,173)\"\u003e four times followed by \u003cimg id\u003d\"token_18960\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qyeq.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18960\u0026quot;,265)\"\u003e(\"ADD\") to draw the segment connecting (6, 5) and (2, 5).\u003c/p\u003e\n \u003cp\u003eFinally, press \u003cimg id\u003d\"token_18961\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qtrace.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_18961\u0026quot;,240)\"\u003e (\"DONE\"). We now have our parallelogram.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-9 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_7_1_geometry_2a_60/f-60-2a-5.gif\"\u003e\n\u003cbr\u003e",
