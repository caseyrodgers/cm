      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eFirst, store the value of \u003ci\u003ex\u003c/i\u003e. Press \u003cimg id\u003d\"token_16292\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qfrac.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16292\u0026quot;,154)\"\u003e \u003cimg id\u003d\"token_16293\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q1.gif\"\u003e \u003cimg id\u003d\"token_16294\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdown.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16294\u0026quot;,136)\"\u003e \u003cimg id\u003d\"token_16295\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2.gif\"\u003e \u003cimg id\u003d\"token_16296\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qsto.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16296\u0026quot;,225)\"\u003e\u003cimg id\u003d\"token_16297\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qx73.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16297\u0026quot;,263)\"\u003e \u003cimg id\u003d\"token_16298\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16298\u0026quot;,144)\"\u003e.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-1 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_1_1_operations,expressions,andvariables_9_1/f-1-9-1.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eStore the value of \u003ci\u003ey\u003c/i\u003e.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eNow store the value of \u003ci\u003ey\u003c/i\u003e. Press \u003cimg id\u003d\"token_16299\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qfrac.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16299\u0026quot;,154)\"\u003e \u003cimg id\u003d\"token_16300\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qnegative.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16300\u0026quot;,189)\"\u003e \u003cimg id\u003d\"token_16301\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q1.gif\"\u003e \u003cimg id\u003d\"token_16302\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdown.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16302\u0026quot;,136)\"\u003e \u003cimg id\u003d\"token_16303\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q4.gif\"\u003e \u003cimg id\u003d\"token_16304\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qsto.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16304\u0026quot;,225)\"\u003e. To get the letter Y, press \u003cimg id\u003d\"token_16305\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2nd.gif\"\u003e. Use the arrow keys to move to Y, press \u003cimg id\u003d\"token_16307\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16307\u0026quot;,144)\"\u003e, then go to DONE and press \u003cimg id\u003d\"token_16308\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16308\u0026quot;,144)\"\u003e again. This will get you back to the home screen. Press \u003cimg id\u003d\"token_16309\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16309\u0026quot;,144)\"\u003e again to store the value.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-3 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_1_1_operations,expressions,andvariables_9_1/f-1-9-2-anim.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eEnter the expression.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eNow enter the expression. Press \u003cimg id\u003d\"token_16310\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qx73.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16310\u0026quot;,263)\"\u003e. Use \u003cimg id\u003d\"token_16311\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2nd.gif\"\u003e to select the variable Y as before. Then press \u003cimg id\u003d\"token_16313\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qplus.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16313\u0026quot;,203)\"\u003e\u003cimg id\u003d\"token_16314\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qx73.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16314\u0026quot;,263)\"\u003e \u003cimg id\u003d\"token_16315\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qplus.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_16315\u0026quot;,203)\"\u003e, and select Y again.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-5 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_1_1_operations,expressions,andvariables_9_1/f-1-9-3-anim.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
