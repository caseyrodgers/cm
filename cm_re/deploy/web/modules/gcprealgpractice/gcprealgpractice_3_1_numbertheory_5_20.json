    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_17045\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qsimp.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_17045\u0026quot;,214)\"\u003e \u003cimg id\u003d\"token_17046\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_17046\u0026quot;,144)\"\u003e again.\u003c/p\u003e\n\u003c/div\u003e",
