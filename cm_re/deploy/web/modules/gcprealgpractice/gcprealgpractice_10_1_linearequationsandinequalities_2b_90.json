      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_20647\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q2nd.gif\"\u003e \u003cimg id\u003d\"token_20648\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qstat.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20648\u0026quot;,221)\"\u003e \u003cimg id\u003d\"token_20649\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qleft.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_20649\u0026quot;,173)\"\u003e \u003cimg id\u003d\"token_20650\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q5.gif\"\u003e to use the linear regression feature.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
