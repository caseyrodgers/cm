  "statement": "\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eDoes there appear to be a linear correlation in this data? If so, use your calculator to find and graph the linear regression equation.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e",
  "statementFigure": null,
  "question": null,
  "widgetSlot": null,
  "steps": [
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eTake another look at the scatter plot.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
