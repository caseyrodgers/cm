    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_16552\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q1.gif\"\u003e to select Number Line.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-3 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_2_1_integers_2_10/f-10-2-2.gif\"\u003e\n\u003cbr\u003e",
