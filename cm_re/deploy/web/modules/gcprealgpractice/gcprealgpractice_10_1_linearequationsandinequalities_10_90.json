  "statement": "\u003cp\u003e\u003c/p\u003e\n\u003cp\u003eGraph the linear inequality \u003ci\u003ey\u003c/i\u003e \u003cimg id\u003d\"token_21505\" class\u003d\"text-bottom\" src\u003d\"/specialchars/gt.gif\"\u003e –0.8\u003ci\u003ex\u003c/i\u003e + 4 on your calculator.\u003c/p\u003e\n\u003cp\u003e\u003c/p\u003e",
  "statementFigure": null,
  "question": null,
  "widgetSlot": null,
  "steps": [
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_21506\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qyeq.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21506\u0026quot;,265)\"\u003e and change the setting for Y\u003csub\u003e1\u003c/sub\u003e.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_21507\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qyeq.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21507\u0026quot;,265)\"\u003e. To change the setting for Y\u003csub\u003e1\u003c/sub\u003e from the solid line to a \"greater than \" inequality, press \u003cimg id\u003d\"token_21508\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qleft.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21508\u0026quot;,173)\"\u003e \u003cimg id\u003d\"token_21509\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qleft.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21509\u0026quot;,173)\"\u003e \u003cimg id\u003d\"token_21510\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21510\u0026quot;,144)\"\u003e \u003cimg id\u003d\"token_21511\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qenter.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21511\u0026quot;,144)\"\u003e. The symbol changes to show a line with the half–plane above it shaded.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-1 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_10_1_linearequationsandinequalities_10_90/f-90-11-1.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eEnter the right hand side of the inequality.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eTo enter the right hand side of the inequality, press \u003cimg id\u003d\"token_21512\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21512\u0026quot;,211)\"\u003e \u003cimg id\u003d\"token_21513\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qright.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21513\u0026quot;,211)\"\u003e \u003cimg id\u003d\"token_21514\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qnegative.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21514\u0026quot;,189)\"\u003e \u003cimg id\u003d\"token_21515\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q0.gif\"\u003e \u003cimg id\u003d\"token_21516\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qdot.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21516\u0026quot;,135)\"\u003e \u003cimg id\u003d\"token_21517\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q8.gif\"\u003e\u003cimg id\u003d\"token_21518\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qx73.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21518\u0026quot;,263)\"\u003e \u003cimg id\u003d\"token_21519\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qplus.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21519\u0026quot;,203)\"\u003e \u003cimg id\u003d\"token_21520\" class\u003d\"text-bottom\" src\u003d\"/specialchars/q4.gif\"\u003e.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-3 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_10_1_linearequationsandinequalities_10_90/f-90-11-2.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cdiv class\u003d\"question\"\u003e\n  \u003cp\u003eWhat would be an appropriate viewing window for this graph?\u003c/p\u003e\n \u003c/div\u003e\n \u003cdiv class\u003d\"question_guess\"\u003e\n  \u003cimg onmouseover\u003d\"doQuestionResponse(\u0027rid_4774\u0027,\u0027yes\u0027);\" onmouseout\u003d\"doQuestionResponseEnd();\" src\u003d\"/images/tutor5/hint_question-16x16.gif\" name\u003d\"question_0\"\u003e\u0026nbsp;\n  \u003cp\u003eXmin \u003d –10, Xmax \u003d 10, Xscl \u003d 1, Ymin \u003d –10, Ymax \u003d 10, Yscl \u003d 1\u003c/p\u003e\n \u003c/div\u003e\n \u003cdiv class\u003d\"question_guess\"\u003e\n  \u003cimg onmouseover\u003d\"doQuestionResponse(\u0027rid_4775\u0027,\u0027no\u0027);\" onmouseout\u003d\"doQuestionResponseEnd();\" src\u003d\"/images/tutor5/hint_question-16x16.gif\" name\u003d\"question_1\"\u003e\u0026nbsp;\n  \u003cp\u003eXmin \u003d –100, Xmax \u003d 100, Xscl \u003d 10, Ymin \u003d –100, Ymax \u003d 100, Yscl \u003d 10\u003c/p\u003e\n \u003c/div\u003e\n \u003cdiv class\u003d\"question_guess\"\u003e\n  \u003cimg onmouseover\u003d\"doQuestionResponse(\u0027rid_4776\u0027,\u0027no\u0027);\" onmouseout\u003d\"doQuestionResponseEnd();\" src\u003d\"/images/tutor5/hint_question-16x16.gif\" name\u003d\"question_2\"\u003e\u0026nbsp;\n  \u003cp\u003eXmin \u003d 0, Xmax \u003d 20, Xscl \u003d 2, Ymin \u003d 0, Ymax \u003d 20, Yscl \u003d 2\u003c/p\u003e\n \u003c/div\u003e\n \u003cdiv class\u003d\"question_guess\"\u003e\n  \u003cimg onmouseover\u003d\"doQuestionResponse(\u0027rid_4777\u0027,\u0027yes\u0027);\" onmouseout\u003d\"doQuestionResponseEnd();\" src\u003d\"/images/tutor5/hint_question-16x16.gif\" name\u003d\"question_3\"\u003e\u0026nbsp;\n  \u003cp\u003eXmin \u003d –20, Xmax \u003d 20, Xscl \u003d 2, Ymin \u003d –20, Ymax \u003d 20, Yscl \u003d 2\u003c/p\u003e\n \u003c/div\u003e\n\u003c/div\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eThe slope of the line is small.\u003c/p\u003e\n \u003cp\u003eSo, press \u003cimg id\u003d\"token_21521\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qwindow.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21521\u0026quot;,255)\"\u003e and you can set Xmin \u003d –20, Xmax \u003d 20, Xscl \u003d 2, Ymin \u003d –20, Ymax \u003d 20, Yscl \u003d 2.\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-5 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_10_1_linearequationsandinequalities_10_90/f-90-11-3.gif\"\u003e\n\u003cbr\u003e",
      "figure": null,
      "figures": null
    },
    {
      "role": "hint",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003ePress \u003cimg id\u003d\"token_21522\" class\u003d\"text-bottom\" src\u003d\"/specialchars/qgraph.gif\" onmouseout\u003d\"return parent.doMouseOut()\" onmouseover\u003d\"return parent.doMouseOver(\u0026quot;token_21522\u0026quot;,157)\"\u003e to graph the inequality.\u003c/p\u003e\n\u003c/div\u003e",
      "figure": null,
