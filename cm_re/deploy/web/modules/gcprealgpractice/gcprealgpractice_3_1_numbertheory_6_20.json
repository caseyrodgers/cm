    {
      "role": "step",
      "content": "\u003cdiv class\u003d\"step_content\"\u003e\n \u003cp\u003eContinue until you get to 1/1.\u003c/p\u003e\n \u003cp\u003eLooking through the list of factors, we find that the prime factorization of 693 is\u003c/p\u003e\n \u003cp\u003e693 \u003d 3 \u003cimg id\u003d\"token_17101\" class\u003d\"text-bottom\" src\u003d\"/specialchars/times.gif\"\u003e 3 \u003cimg id\u003d\"token_17102\" class\u003d\"text-bottom\" src\u003d\"/specialchars/times.gif\"\u003e 7 \u003cimg id\u003d\"token_17103\" class\u003d\"text-bottom\" src\u003d\"/specialchars/times.gif\"\u003e 11\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n \u003cp\u003e\u003c/p\u003e\n\u003c/div\u003e\u003cimg class\u003d\"graphimgstatic id\u003d\" figure-9 src\u003d\"/modules/gcprealgpractice/gcprealgpractice_3_1_numbertheory_6_20/f-20-6-5.gif\"\u003e\n\u003cbr\u003e",
